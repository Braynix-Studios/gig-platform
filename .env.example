# Test Credentials (dev/demo only; replace with strong random values)
TEST_DEV_EMAIL="dev@gig.dev"
TEST_DEV_PASSWORD="change-me"
TEST_BIZ_EMAIL="biz@gig.dev"
TEST_BIZ_PASSWORD="change-me"

# Session Security
# Required in production. Generate with: openssl rand -base64 32
SESSION_SECRET="gig-dev-default-secret-key-replace-in-prod-32chars"
SESSION_COOKIE_NAME="gig_session"

# Legacy HMAC demo session for LOCAL DEVELOPMENT ONLY.
# Set "true" for the demo login (dev@gig.dev / biz@gig.dev). It is ignored
# whenever NODE_ENV=production, so it can never reach a live deployment.
ENABLE_LEGACY_SESSION="true"

# Supabase (required for production auth)
# New-style Supabase API keys map as:
#   publishable key (sb_publishable_*) -> SUPABASE_ANON_KEY (browser-safe, RLS enforced)
#   secret key      (sb_secret_*)      -> SUPABASE_SERVICE_ROLE_KEY (server-only, bypasses RLS)
SUPABASE_URL="your-supabase-project-url"
NEXT_PUBLIC_SUPABASE_URL="your-supabase-project-url"
SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-secret-key"
SUPABASE_COOKIE_NAME="gig_supabase_auth_token"

# App URL (used for OAuth redirectTo)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# GitHub OAuth (configured in Supabase Dashboard, not needed here)
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"
